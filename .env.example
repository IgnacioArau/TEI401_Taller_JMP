# Configuración secreta del taller.
# 1) Copia este archivo con el nombre ".env"  (en Windows: copy .env.example .env)
# 2) Escribe tu contraseña de administrador y guarda.
# El archivo ".env" NO se sube a GitHub. Nunca escribas contraseñas reales en este archivo de ejemplo.

# Usuario para entrar a /admin
ADMIN_USER=admin

# Contraseña para entrar a /admin. Usa 12 o más caracteres. Si lleva espacios o el símbolo #, déjala entre comillas.
ADMIN_PASSWORD="CAMBIA-ESTA-CLAVE-LARGA"

# Opcionales (normalmente no hace falta tocarlos):
# PORT=3000
# HOST=127.0.0.1      # usa 0.0.0.0 solo si quieres abrir la página desde otro dispositivo de tu red local
